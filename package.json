{
  "name": "native-react-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace=@app/mobile run start",
    "android": "npm --workspace=@app/mobile run android",
    "ios": "npm --workspace=@app/mobile run ios",
    "web": "npm --workspace=@app/mobile run web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "nativewind": "^4.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
