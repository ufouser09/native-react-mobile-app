{
  "name": "native-react-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace=@app/mobile run start",
    "android": "npm --workspace=@app/mobile run android",
    "ios": "npm --workspace=@app/mobile run ios",
    "web": "npm --workspace=@app/mobile run web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/types": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react-native": "^1.47.0",
    "nativewind": "^4.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
